<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <SelectDialog
        id="materialVHDialog"
        title="{i18n>VALUEHELP_MATERIAL_TITLE}"
        search="onMaterialVHSearch"
        confirm="onMaterialVHConfirm"
        growing="true"
        growingThreshold="30"
        items="{matvh>/items}"
    >
        <StandardListItem
            id="matVHItem"
            title="{matvh>matnr}"
            description="{matvh>maktx}"
        />
    </SelectDialog>
</core:FragmentDefinition>
