<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
>
    <Dialog
        title="{= ${view>/selectedGroup/date} + ' ' + ${i18n>WORKCENTER_LOAD} }"
        contentWidth="1100px"
        contentHeight="600px"
        draggable="true"
        resizable="true"
        stretch="{device>/system/phone}"
    >
        <content>
            <!-- 오더 타입별 통계 (KPI 카드) — 스크롤 시 상단 고정(pin) -->
            <VBox
                renderType="Bare"
                width="100%"
                class="kpiStickyWrap"
            >
                <HBox
                    renderType="Bare"
                    width="100%"
                    class="kpiCardRow"
                >
                    <VBox class="kpiCard kpiCard--plan">
                        <Text
                            text="{i18n>KPI_PLAN}"
                            class="kpiCard-label"
                        />
                        <Title
                            text="{view>/selectedGroup/orderStats/plCnt}"
                            level="H2"
                            class="kpiCard-num"
                        />
                        <Text
                            text="{i18n>UNIT_PIECES}"
                            class="kpiCard-unit"
                        />
                    </VBox>

                    <VBox class="kpiCard kpiCard--prod">
                        <Text
                            text="{i18n>KPI_PROD}"
                            class="kpiCard-label"
                        />
                        <Title
                            text="{view>/selectedGroup/orderStats/msCnt}"
                            level="H2"
                            class="kpiCard-num"
                        />
                        <Text
                            text="{i18n>UNIT_PIECES}"
                            class="kpiCard-unit"
                        />
                    </VBox>

                    <VBox class="kpiCard kpiCard--repair">
                        <Text
                            text="{i18n>KPI_REPAIR}"
                            class="kpiCard-label"
                        />
                        <Title
                            text="{view>/selectedGroup/orderStats/rpCnt}"
                            level="H2"
                            class="kpiCard-num"
                        />
                        <Text
                            text="{i18n>UNIT_PIECES}"
                            class="kpiCard-unit"
                        />
                    </VBox>

                    <VBox class="kpiCard kpiCard--urgent">
                        <Text
                            text="{i18n>KPI_URGENT}"
                            class="kpiCard-label"
                        />
                        <Title
                            text="{view>/selectedGroup/orderStats/urCnt}"
                            level="H2"
                            class="kpiCard-num"
                        />
                        <Text
                            text="{i18n>UNIT_PIECES}"
                            class="kpiCard-unit"
                        />
                    </VBox>
                </HBox>
            </VBox>

            <!-- 워크센터별 토글 리스트 -->
            <List
                items="{view>/selectedGroup/workCenters}"
                showSeparators="None"
            >
                <CustomListItem>
                    <Panel
                        expandable="true"
                        expanded="{view>expanded}"
                        class="sapUiTinyMarginBottom"
                    >
                        <headerToolbar>
                            <Toolbar>
                                <Title
                                    text="{view>arbpl} · {view>ktext}"
                                    level="H4"
                                />
                                <ToolbarSpacer />
                                <ObjectStatus
                                    text="{i18n>STATUS_PLAN}"
                                    state="Information"
                                    class="sapUiTinyMarginEnd"
                                />
                                <ObjectStatus
                                    text="{= ${view>schdCount} + ' ' + ${i18n>UNIT_PIECES}}"
                                    state="None"
                                    class="sapUiTinyMarginEnd"
                                />
                                <ObjectStatus
                                    text="{i18n>STATUS_RUNNING}"
                                    state="Warning"
                                    class="sapUiTinyMarginEnd"
                                />
                                <ObjectStatus
                                    text="{= ${view>runCount} + ' ' + ${i18n>UNIT_PIECES}}"
                                    state="None"
                                    class="sapUiTinyMarginEnd"
                                />
                                <ObjectStatus
                                    text="{i18n>STATUS_DONE}"
                                    state="Success"
                                    class="sapUiTinyMarginEnd"
                                />
                                <ObjectStatus
                                    text="{= ${view>doneCount} + ' ' + ${i18n>UNIT_PIECES}}"
                                    state="None"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Text
                                    text="{i18n>LABEL_TOTAL}"
                                    class="kpiTotalLabel"
                                />
                                <Text
                                    text="{= ${view>count} + ' ' + ${i18n>UNIT_PIECES}}"
                                    class="kpiTotalLbl"
                                />
                            </Toolbar>
                        </headerToolbar>

                        <content>
                            <Table
                                items="{view>operations}"
                                popinLayout="Block"
                            >
                                <columns>
                                    <Column width="110px">
                                        <header>
                                            <Text text="{i18n>COL_ORDER_NO}" />
                                        </header>
                                    </Column>
                                    <Column
                                        width="60px"
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <header>
                                            <Text text="{i18n>COL_OPERATION}" />
                                        </header>
                                    </Column>
                                    <Column
                                        width="140px"
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <header>
                                            <Text
                                                text="{i18n>COL_OPERATION_NAME}"
                                            />
                                        </header>
                                    </Column>
                                    <Column
                                        width="70px"
                                        hAlign="Center"
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <header>
                                            <Text text="{i18n>COL_TYPE}" />
                                        </header>
                                    </Column>
                                    <Column>
                                        <header>
                                            <Text text="{i18n>COL_MATERIAL}" />
                                        </header>
                                    </Column>
                                    <Column
                                        width="120px"
                                        hAlign="End"
                                    >
                                        <header>
                                            <Text text="{i18n>COL_QTY}" />
                                        </header>
                                    </Column>
                                    <Column
                                        width="80px"
                                        hAlign="Center"
                                    >
                                        <header>
                                            <Text text="{i18n>COL_STATUS}" />
                                        </header>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem
                                        type="Active"
                                        press="onOrderPress"
                                        highlight="{= ${view>_earlyDone} ? 'Information' : 'None' }"
                                    >
                                        <cells>
                                            <Text text="{view>Aufnr}" />
                                            <Text text="{view>Vornr}" />
                                            <Text text="{view>Ltxa1}" />
                                            <ObjectStatus
                                                text="{= ${view>Autyp} === 'MS' ? '생산' :
                                                       ${view>Autyp} === 'UR' ? '긴급' :
                                                       ${view>Autyp} === 'RP' ? '수리' :
                                                       ${view>Autyp} === 'PL' ? '계획' : ${view>Autyp}
                                                }"
                                                state="{= ${view>Autyp} === 'MS' ? 'Success' :
                                                         ${view>Autyp} === 'UR' ? 'Error' :
                                                         ${view>Autyp} === 'RP' ? 'Warning' :
                                                         ${view>Autyp} === 'PL' ? 'Information' : 'None'
                                                }"
                                                inverted="true"
                                            />
                                            <ObjectIdentifier
                                                id="popMatId"
                                                title="{view>Matnr}"
                                                text="{view>Maktx}"
                                            />
                                            <VBox alignItems="End">
                                                <ObjectNumber
                                                    number="{view>Day_yield} / {view>Gamng}"
                                                    unit="{view>Gmein}"
                                                    emphasized="true"
                                                />
                                                <Text
                                                    text="{= ${i18n>TEXT_TOTAL_QTY} + ' ' + ${view>order_qty} + ' ' + ${view>Gmein}}"
                                                    class="sapUiTinyText"
                                                />
                                            </VBox>
                                            <ObjectStatus
                                                text="{= ${view>_earlyDone} ? ${i18n>MSG_EARLY_DONE} :
                                                       ${view>Statu} === 'SCHD' ? ${i18n>STATUS_PLAN} :
                                                       ${view>Statu} === 'RUN' ? ${i18n>STATUS_RUNNING} :
                                                       ${view>Statu} === 'DONE' ? ${i18n>STATUS_DONE} : ${view>Statu}
                                                }"
                                                state="{= ${view>_earlyDone} ? 'Information' :
                                                         ${view>Statu} === 'DONE' ? 'Success' :
                                                         ${view>Statu} === 'RUN' ? 'Warning' :
                                                         ${view>Statu} === 'SCHD' ? 'None' : 'None'
                                                }"
                                                tooltip="{= ${view>_earlyDone} ? ${i18n>TOOLTIP_EARLY_DONE} : '' }"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </Panel>
                </CustomListItem>
            </List>
        </content>

        <buttons>
            <Button
                text="{i18n>BUTTON_CLOSE}"
                press="onCloseDetailPopover"
                type="Emphasized"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
