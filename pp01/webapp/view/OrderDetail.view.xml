<mvc:View
    controllerName="code.t4.ui5.pp01.controller.OrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
>
    <Page
        title="오더 상세"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <ObjectHeader
                title="오더 {view>/aufnr}"
                number="{view>/vornr}"
                numberUnit="공정"
                responsive="true"
            >
                <attributes>
                    <ObjectAttribute
                        title="라우팅"
                        text="{view>/plnnr}"
                    />
                </attributes>
            </ObjectHeader>

            <Panel
                headerText="오더별 실적 조회"
                expandable="false"
                class="sapUiResponsiveMargin"
            >
                <content>
                    <MessageStrip
                        text="이 페이지는 다음 단계에서 구현될 예정입니다."
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBottom"
                    />
                    <Text
                        text="오더번호: {view>/aufnr}"
                        class="sapUiSmallMarginTop"
                    />
                    <Text text="라우팅번호: {view>/plnnr}" />
                    <Text text="공정순번: {view>/vornr}" />
                </content>
            </Panel>
        </content>
    </Page>
</mvc:View>
