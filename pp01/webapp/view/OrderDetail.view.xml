<mvc:View
    controllerName="code.t4.ui5.pp01.controller.OrderDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
>
    <Page
        title="{i18n>ORDER_DETAIL_TITLE}"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <ObjectHeader
                title="{= ${i18n>ORDER_LABEL} + ' ' + ${view>/aufnr}}"
                number="{view>/vornr}"
                numberUnit="{i18n>UNIT_OPERATION}"
                responsive="true"
            >
                <attributes>
                    <ObjectAttribute
                        title="{i18n>LABEL_ROUTING}"
                        text="{view>/plnnr}"
                    />
                </attributes>
            </ObjectHeader>

            <Panel
                headerText="{i18n>PANEL_ORDER_PERF}"
                expandable="false"
                class="sapUiResponsiveMargin"
            >
                <content>
                    <MessageStrip
                        text="{i18n>MSG_PAGE_TBD}"
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBottom"
                    />
                    <Text
                        text="{= ${i18n>LABEL_ORDER_NO} + ' ' + ${view>/aufnr}}"
                        class="sapUiSmallMarginTop"
                    />
                    <Text
                        text="{= ${i18n>LABEL_ROUTING_NO} + ' ' + ${view>/plnnr}}"
                    />
                    <Text
                        text="{= ${i18n>LABEL_OPERATION_SEQ} + ' ' + ${view>/vornr}}"
                    />
                </content>
            </Panel>
        </content>
    </Page>
</mvc:View>
