<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <SelectDialog
        id="orderVHDialog"
        title="{i18n>VALUEHELP_ORDER_TITLE}"
        search="onOrderVHSearch"
        confirm="onOrderVHConfirm"
        growing="true"
        growingThreshold="30"
        items="{ordervh>/items}"
    >
        <StandardListItem
            id="ordVHItem"
            title="{ordervh>aufnr}"
            description="{ordervh>matnr} · {ordervh>maktx}"
            info="{ordervh>statu}"
        />
    </SelectDialog>
</core:FragmentDefinition>
