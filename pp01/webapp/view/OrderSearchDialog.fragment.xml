<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="orderSearchDialog"
        title="{i18n>ORDER_SEARCH_TITLE}"
        contentWidth="700px"
        contentHeight="600px"
        draggable="true"
        resizable="true"
        stretch="{device>/system/phone}"
    >
        <content>
            <VBox
                id="osForm"
                class="sapUiSmallMargin"
            >
                <!-- 조회 조건 -->
                <Label
                    id="osLblAufnr"
                    text="{i18n>LABEL_ORDER_NO}"
                />
                <Input
                    id="osInpAufnr"
                    value="{osearch>/aufnr}"
                    placeholder="{i18n>PLACEHOLDER_ORDER_NO}"
                    width="100%"
                    submit="onOrderSearchGo"
                    showValueHelp="true"
                    valueHelpRequest="onSearchAufnrVH"
                />
                <Label
                    id="osLblMatnr"
                    text="{i18n>LABEL_MATERIAL_CODE}"
                    class="sapUiSmallMarginTop"
                />
                <Input
                    id="osInpMatnr"
                    value="{osearch>/matnr}"
                    placeholder="{i18n>PLACEHOLDER_MATERIAL_CODE}"
                    width="100%"
                    submit="onOrderSearchGo"
                    showValueHelp="true"
                    valueHelpRequest="onSearchMatnrVH"
                />
                <Label
                    id="osLblVbeln"
                    text="{i18n>LABEL_SOURCE_NO}"
                    class="sapUiSmallMarginTop"
                />
                <Input
                    id="osInpVbeln"
                    value="{osearch>/vbeln}"
                    placeholder="{i18n>PLACEHOLDER_SOURCE_NO}"
                    width="100%"
                    submit="onOrderSearchGo"
                    showValueHelp="true"
                    valueHelpRequest="onSearchVbelnVH"
                />
                <Label
                    id="osLblStatu"
                    text="{i18n>LABEL_PROD_STATUS}"
                    class="sapUiSmallMarginTop"
                />
                <Select
                    id="osSelStatu"
                    selectedKey="{osearch>/statu}"
                    width="100%"
                >
                    <core:Item
                        id="osStatAll"
                        key=""
                        text="{i18n>LABEL_ALL}"
                    />
                    <core:Item
                        id="osStatSchd"
                        key="SCHD"
                        text="{i18n>STATUS_PLAN}"
                    />
                    <core:Item
                        id="osStatRel"
                        key="REL"
                        text="{i18n>STATUS_RELEASE}"
                    />
                    <core:Item
                        id="osStatRun"
                        key="RUN"
                        text="{i18n>STATUS_RUNNING}"
                    />
                    <core:Item
                        id="osStatDone"
                        key="DONE"
                        text="{i18n>STATUS_DONE}"
                    />
                </Select>

                <Button
                    id="osBtnGo"
                    text="{i18n>BUTTON_SEARCH}"
                    type="Emphasized"
                    icon="sap-icon://search"
                    press="onOrderSearchGo"
                    class="sapUiSmallMarginTop"
                />

                <!-- 조회 결과 -->
                <Table
                    id="orderSearchTable"
                    items="{osearch>/results}"
                    growing="true"
                    growingThreshold="20"
                    class="sapUiSmallMarginTop"
                >
                    <headerToolbar>
                        <OverflowToolbar id="osResToolbar">
                            <Title
                                id="osResTitle"
                                text="{= ${i18n>RESULT_HEADER} + ' ' + ${osearch>/results}.length + ' ' + ${i18n>UNIT_PIECES} }"
                                level="H5"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="osColAufnr">
                            <header>
                                <Text
                                    id="osHAufnr"
                                    text="{i18n>COL_ORDER_NO}"
                                />
                            </header>
                        </Column>
                        <Column id="osColMat">
                            <header>
                                <Text
                                    id="osHMat"
                                    text="{i18n>COL_MATERIAL}"
                                />
                            </header>
                        </Column>
                        <Column
                            id="osColVbeln"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <header>
                                <Text
                                    id="osHVbeln"
                                    text="{i18n>COL_SOURCE}"
                                />
                            </header>
                        </Column>
                        <Column
                            id="osColQty"
                            hAlign="End"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <header>
                                <Text
                                    id="osHQty"
                                    text="{i18n>COL_QTY}"
                                />
                            </header>
                        </Column>
                        <Column
                            id="osColStatu"
                            hAlign="Center"
                            width="6rem"
                        >
                            <header>
                                <Text
                                    id="osHStatu"
                                    text="{i18n>COL_STATUS}"
                                />
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            id="osRow"
                            type="Active"
                            press="onOrderSearchRowPress"
                        >
                            <cells>
                                <ObjectIdentifier
                                    id="osCellAufnr"
                                    title="{osearch>aufnr}"
                                />
                                <ObjectIdentifier
                                    id="osCellMatBox"
                                    title="{osearch>matnr}"
                                    text="{osearch>maktx}"
                                />
                                <Text
                                    id="osCellVbeln"
                                    text="{osearch>vbeln}"
                                />
                                <ObjectNumber
                                    id="osCellQty"
                                    number="{osearch>psmng}"
                                    unit="{osearch>gmein}"
                                />
                                <ObjectStatus
                                    id="osCellStatu"
                                    text="{osearch>statu}"
                                    state="{= ${osearch>statu} === 'DONE' ? 'Success' : ${osearch>statu} === 'RUN' ? 'Warning' : ${osearch>statu} === 'REL' ? 'Success' : 'Information' }"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <buttons>
            <Button
                id="osBtnClose"
                text="{i18n>BUTTON_CLOSE}"
                press="onOrderSearchClose"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
